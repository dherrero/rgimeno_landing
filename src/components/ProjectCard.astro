---
import type { Project } from "../data/content";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const headingId = `project-${project.id}`;
---

<article class="card" aria-labelledby={headingId}>
  <div class="card__top">
    <p class="card__meta">
      <span class="card__role">{project.role}</span>
      <span aria-hidden="true">·</span>
      <span>{project.year}</span>
    </p>
    <h3 id={headingId} class="card__title">{project.title}</h3>
    <p class="card__summary">{project.summary}</p>
  </div>

  <div class="card__bottom">
    <h4 class="card__subtitle">Resultados</h4>
    <ul class="card__highlights" role="list">
      {project.highlights.map((item) => <li>{item}</li>)}
    </ul>

    <ul class="card__tags" role="list" aria-label="Áreas de trabajo">
      {project.tags.map((tag) => <li class="card__tag">{tag}</li>)}
    </ul>

    {
      project.link && (
        <a class="card__link" href={project.link.href}>
          {project.link.label}
          <span aria-hidden="true">→</span>
        </a>
      )
    }
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    padding: var(--space-l);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-l);
    box-shadow: var(--shadow-s);
    height: 100%;
  }

  .card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5ch;
    color: var(--color-muted);
    font-size: var(--step--1);
  }

  .card__role {
    color: var(--color-accent);
    font-weight: 600;
  }

  .card__title {
    margin-top: var(--space-2xs);
    font-size: var(--step-2);
  }

  .card__summary {
    margin-top: var(--space-xs);
    color: var(--color-muted);
  }

  .card__bottom {
    margin-top: auto;
  }

  .card__subtitle {
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-muted);
  }

  .card__highlights {
    margin: var(--space-xs) 0 var(--space-m);
    padding: 0;
    display: grid;
    gap: var(--space-2xs);
  }

  .card__highlights li {
    position: relative;
    padding-inline-start: 1.5rem;
  }

  .card__highlights li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin: 0 0 var(--space-m);
    padding: 0;
  }

  .card__tag {
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-pill);
    background: var(--color-accent-soft);
    color: var(--color-accent);
    font-size: var(--step--1);
    font-weight: 500;
  }

  .card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5ch;
    font-weight: 600;
    text-decoration: none;
  }

  .card__link:hover {
    text-decoration: underline;
  }
</style>
