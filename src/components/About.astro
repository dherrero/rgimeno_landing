---
import { about, site } from "../data/content";
---

<section id="sobre-mi" class="about section" aria-labelledby="about-heading">
  <div class="container about__grid">
    <div class="about__media">
      {
        /*
        TODO: replace this decorative placeholder with a real photo, e.g.:
        <img src="/ramon.jpg" alt={about.photoAlt} width="480" height="600" />
        Keep the `alt` text descriptive. The placeholder is hidden from
        assistive technology because it carries no information.
      */
      }
      <div class="about__placeholder" aria-hidden="true">
        <span>RA</span>
      </div>
    </div>

    <div class="about__content">
      <p class="eyebrow">{site.role}</p>
      <h2 id="about-heading" class="section-title">{about.heading}</h2>
      {about.paragraphs.map((paragraph) => <p class="about__paragraph">{paragraph}</p>)}
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    gap: var(--space-xl);
    grid-template-columns: 1fr;
    align-items: center;
  }

  @media (min-width: 52rem) {
    .about__grid {
      grid-template-columns: minmax(0, 22rem) 1fr;
    }
  }

  .about__media {
    max-width: 22rem;
  }

  .about__placeholder {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-l);
    background: linear-gradient(150deg, var(--color-accent), var(--color-accent-soft));
    color: var(--color-accent-contrast);
    font-size: var(--step-5);
    font-weight: 700;
    letter-spacing: 0.05em;
    box-shadow: var(--shadow-m);
  }

  .about__paragraph + .about__paragraph {
    margin-top: var(--space-s);
  }

  .about__paragraph {
    color: var(--color-muted);
    font-size: var(--step-1);
  }

  .about__content .section-title {
    margin-block: var(--space-2xs) var(--space-m);
  }
</style>
